#!/bin/sh
# 首次开机：按本机 MAC 尾数自动分角色，刷完插电即成桥，不用 SSH
#   奇数 → AP-WDS (192.168.1.2)   偶数 → STA-WDS (192.168.1.3)
# 若两台尾数同奇偶，在任一台执行  bridge-role sta  手动改一台。
. /usr/lib/bridge/role.sh

get_mac() {
    for f in /sys/class/ieee80211/phy1/macaddress \
             /sys/class/ieee80211/phy0/macaddress \
             /sys/class/net/ath1/address \
             /sys/class/net/ath0/address \
             /sys/class/net/wlan1/address \
             /sys/class/net/eth0/address \
             /sys/class/net/lan1/address \
             /sys/class/net/br-lan/address; do
        [ -r "$f" ] || continue
        m=$(cat "$f" 2>/dev/null | tr -d ':\n' | tr 'A-F' 'a-f')
        case "$m" in *[0-9a-f]*) [ ${#m} -ge 12 ] && { echo "$m"; return 0; } ;; esac
    done
    return 1
}

echo "=== [bridge] 开机自动分角色 ==="
if [ -s /etc/bridge_role ]; then
    ROLE=$(cat /etc/bridge_role)
    echo "  已有手工指定角色: $ROLE"
elif MAC=$(get_mac); then
    LAST=$(printf '%s' "$MAC" | tail -c 1)
    case "$LAST" in
        1|3|5|7|9|b|d|f) ROLE=ap ;;
        *)                ROLE=sta ;;
    esac
    echo "  MAC ...$LAST → $ROLE"
else
    ROLE=ap
    echo "  ::warning:: 读不到稳定 MAC，默认 ap；请用 bridge-role 手动指定"
fi

bridge_apply_role "$ROLE" || echo "  ::warning:: 角色配置失败，可手动执行 bridge-role $ROLE"
rm -f /etc/uci-defaults/99-zz-bridge-role
exit 0
