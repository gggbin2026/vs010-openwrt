#!/bin/sh
# 首次开机执行一次：把机器收拾成「WDS 网桥就绪」状态
#   * 系统时区 = 上海 (CST-8 / Asia/Shanghai)
#   * 所有无线射频国家码 = CN（2.4G + 5G，不依赖段名）
#   * 清 IPv6 配置面 / 开 STP / 防火墙全放行
# 不碰 DHCP / IP —— 主端要发地址，副端才关 DHCP，角色见 99-zz-bridge-role
. /lib/functions.sh

# ── 1. 系统时区：上海（UTC+8，无夏令时）─────────────────────────
# 用内建 POSIX TZ 字符串，不装 zoneinfo 数据包（保持插件最少）。
# 编译机 runner 的 TZ 已是 Asia/Shanghai，这里补的是「固件运行时」。
if uci -q get system.@system[0] >/dev/null; then
    uci -q set system.@system[0].timezone='CST-8'
    uci -q set system.@system[0].zonename='Asia/Shanghai'
    uci commit system
    [ -x /etc/init.d/system ] && /etc/init.d/system reload 2>/dev/null || true
fi

# ── 2. 无线：所有射频国家码统一 CN ─────────────────────────────
# 不依赖 radio0/radio1 段名 —— QSDK/ath11k 不同批次可能是 wifi0/wifi1
# 或 @wifi-device[0/1]，用 config_foreach 遍历最稳。
[ -s /etc/config/wireless ] || { wifi config 2>/dev/null || /sbin/wifi config 2>/dev/null || true; }
if [ -s /etc/config/wireless ]; then
    set_cn_all() { uci -q set "wireless.$1.country=CN"; }
    config_load wireless
    config_foreach set_cn_all wifi-device
    # 固定名双保险（少数 QSDK 树 config_foreach 对匿名段行为不同）
    uci -q set wireless.radio0.country='CN' 2>/dev/null || true
    uci -q set wireless.radio1.country='CN' 2>/dev/null || true
    # 保持两个射频处于启用状态；角色脚本只接管 5G
    uci -q set wireless.radio0.disabled='0' 2>/dev/null || true
    uci -q set wireless.radio1.disabled='0' 2>/dev/null || true
    uci commit wireless
fi
# 内核 cfg80211 regdom 兜底（wifi 起来前先设，失败不影响后续）
if command -v iw >/dev/null 2>&1; then
    iw reg set CN 2>/dev/null || true
elif [ -x /usr/sbin/iw ]; then
    /usr/sbin/iw reg set CN 2>/dev/null || true
fi

# ── 3. 彻底清掉 IPv6 配置面（编译层已关内核 IPv6，这里清 /etc/config）──
uci -q delete network.wan6
uci -q delete network.lan.ip6assign
uci -q delete network.lan.ip6hint
uci -q delete dhcp.lan.ra
uci -q delete dhcp.lan.dhcpv6
uci -q delete dhcp.lan.ndp
uci set dhcp.lan.ra='disabled'
uci set dhcp.lan.dhcpv6='disabled'
uci set dhcp.lan.ndp='disabled'
uci -q delete dhcp.wan6
if [ -x /etc/init.d/odhcpd ]; then
    /etc/init.d/odhcpd disable 2>/dev/null || true
    /etc/init.d/odhcpd stop 2>/dev/null || true
fi

# ── 4. 二层桥接：开 STP，关掉用不上的 NAT/防火墙过滤 ──
uci set network.lan.stp='1'
uci set network.lan.force_link='1'
if uci -q get firewall.@defaults[0] >/dev/null; then
    uci set firewall.@defaults[0].input='ACCEPT'
    uci set firewall.@defaults[0].output='ACCEPT'
    uci set firewall.@defaults[0].forward='ACCEPT'
    uci set firewall.@defaults[0].flow_offloading='0'
    uci set firewall.@defaults[0].flow_offloading_hw='0'
    uci commit firewall
fi
uci commit network
uci commit dhcp

# ── 5. 关掉开机自启的无关服务（能省一点 256MB 内存）──
for s in odhcpd dnsmasq_full_ipv6; do
    [ -x "/etc/init.d/$s" ] && /etc/init.d/"$s" disable 2>/dev/null || true
done

# uci-defaults 执行完删掉自己，避免每次重启重复改
rm -f /etc/uci-defaults/99-bridge-ready
exit 0
