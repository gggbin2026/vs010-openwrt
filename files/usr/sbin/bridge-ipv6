#!/bin/sh
# bridge-ipv6 —— 本版 IPv6 已在编译期关闭，运行时无法开启
#   CONFIG_IPV6 / CONFIG_KERNEL_IPV6 / ip6tables / nat6 / conntrack6 / odhcpd
#   全部未编入；wan6 接口已删除。需要 IPv6 必须改 .config 重新编译。
case "$1" in
    status|'')
        echo "IPv6: 编译期关闭（内核无 IPv6 栈）"
        echo "wan6: $(uci -q get network.wan6.proto 2>/dev/null || echo 已删除)"
        echo "ra=$(uci -q get dhcp.lan.ra 2>/dev/null || echo 未配置)  dhcpv6=$(uci -q get dhcp.lan.dhcpv6 2>/dev/null || echo 未配置)";;
    on)  echo "✗ 本版 IPv6 在编译期关闭，无法运行时开启；请修改 .config 后重新编译";;
    off) echo "✓ 本版 IPv6 本来就是关闭状态";;
    *)   echo "用法: bridge-ipv6 {status|on|off}";;
esac
