#!/bin/sh
. /usr/lib/bridge/role.sh
case "$1" in
    ap|sta)
        bridge_apply_role "$1" || exit 1
        echo "执行 wifi reload 生效（或 reboot 更干净）"
        wifi reload 2>/dev/null || true
        ;;
    auto)
        rm -f /etc/bridge_role
        echo "已清除手工角色，重启后按 MAC 自动分";;
    show|'')
        printf '当前角色: %s\n' "$(cat /etc/bridge_role 2>/dev/null || echo 未设置)"
        uci -q get wireless.@wifi-iface[0].mode
        uci -q get network.lan.ipaddr
        ;;
    *) echo "用法: bridge-role {ap|sta|auto|show}" >&2; exit 1;;
esac
