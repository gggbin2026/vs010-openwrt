#!/bin/sh
# 一眼看链路：角色 / 桥 / 关联 / 端口速率 / 4addr
echo "===== bridge-status ====="
[ -r /etc/bridge_info ] && . /etc/bridge_info
echo "角色     : ${role:-$(cat /etc/bridge_role 2>/dev/null || echo '?')}"
echo "管理 IP  : $(uci -q get network.lan.ipaddr)/$(uci -q get network.lan.netmask)"
echo "SSID     : ${ssid:-$(uci -q get wireless.@wifi-iface[0].ssid)}  ch ${chan:-?}  5G=${radio:-?}"
echo "WDS      : $(uci -q get "wireless.@wifi-iface[${iface:-0}].wds")   mode $(uci -q get "wireless.@wifi-iface[${iface:-0}].mode")"
echo "DHCP     : ignore=$(uci -q get dhcp.lan.ignore)（1 = 本机不发地址，纯透传）"
echo "IPv6     : RA=$(uci -q get dhcp.lan.ra)  DHCPv6=$(uci -q get dhcp.lan.dhcpv6)"
echo
echo "-- 关联站点（QSDK NSS offload 下速率列常为 N/A，用 iperf3 看真值）--"
for i in ath1 ath0 ath11 ath10 wlan1 wlan0 phy1-ap0 phy0-ap0; do
    [ -d "/sys/class/net/$i" ] || continue
    printf '[%s]\n' "$i"
    iwinfo "$i" assoclist 2>/dev/null | head -6
done
echo
echo "-- 端口真值 --"
if [ -x /usr/sbin/portstat ]; then
    /usr/sbin/portstat
else
    swconfig dev switch1 show 2>/dev/null | grep -E 'port:|link:|speed|duplex' | head -30
fi
echo
echo "-- 4addr --"
for i in ath1 ath0 wlan1 wlan0 phy1-ap0 phy0-ap0; do
    [ -d "/sys/class/net/$i" ] && { printf '%s: ' "$i"; iw dev "$i" get 4addr 2>/dev/null || echo 'N/A'; }
done
echo "=========================="
