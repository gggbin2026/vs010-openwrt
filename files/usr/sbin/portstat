#!/bin/sh
# portstat —— 看「真实」速率，别看 LuCI 那个格子
#
# QSDK 5.4 的 nss-dp 是虚拟数据面接口，ethtool 对它拿不到
# get_link_ksettings，LuCI 就回显「半双工 / 速率 —」的占位符。
# 真实 PHY 状态在 QCA8337 的 swconfig 里，这里统一打印出来。
echo "==================== 物理网口 (QCA8337 / swconfig) ===================="
if command -v swconfig >/dev/null 2>&1; then
    swconfig dev switch1 show 2>/dev/null | grep -E 'Port [0-9]+:|link:|speed:|duplex' \
      || swconfig dev switch1 show
else
    echo "  swconfig 未安装"
fi

echo
echo "==================== 数据面接口 (ethtool / sysfs) ===================="
for i in /sys/class/net/*; do
    n=$(basename "$i")
    sp=$(cat "$i/speed" 2>/dev/null || echo '-')
    dp=$(cat "$i/duplex" 2>/dev/null || echo '-')
    op=$(cat "$i/operstate" 2>/dev/null || echo '-')
    printf '  %-10s operstate=%-8s speed=%-6s duplex=%s\n' "$n" "$op" "$sp" "$dp"
done
echo "  注: eth0/eth1 的 speed 可能是 -1/Unknown —— 这是 nss-dp 不上报，"
echo "      不是链路跑在半双工。以上面 swconfig 的 1000baseT full-duplex 为准。"

echo
echo "==================== 无线关联 / 4addr ===================="
for w in /sys/class/net/wlan* /sys/class/net/phy*-ap*; do
    [ -e "$w" ] || continue
    n=$(basename "$w")
    echo "  --- $n ---"
    iw dev "$n" info 2>/dev/null | grep -E 'type|channel|txpower|addr' || true
    iw dev "$n" station dump 2>/dev/null | grep -E 'Station|signal:|tx bitrate:|rx bitrate:' | head -20 || true
done
echo "  注: QSDK NSS WiFi offload 下 tx/rx bitrate 可能不更新或为 0 ——"
echo "      这是统计没回灌 mac80211，不代表协商速率低。用 iperf3 实测吞吐。"

echo
echo "==================== WDS / 4addr 状态 ===================="
for w in /sys/class/net/wlan* /sys/class/net/phy*-ap*; do
    [ -e "$w" ] || continue
    printf '  %-12s 4addr=%s\n' "$(basename "$w")" "$(cat "$w/4addr" 2>/dev/null || echo 'n/a')"
done
dmesg 2>/dev/null | grep -iE '4addr|wds|nss.*wds' | tail -8 || true

echo
echo "==================== 建议 ===================="
echo "  iperf3 -c <对端有线PC> -P 4 -t 60     # 有线千兆应到 900M+"
echo "  iperf3 -c <对端桥IP>   -P 4 -t 60     # WDS 无线侧吞吐"
