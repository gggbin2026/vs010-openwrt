#!/bin/sh
# 默认纯透传不发 DHCP；上游没有 DHCP 时，在 AP 端开一个
case "$1" in
    on)  uci set dhcp.lan.ignore='0'; uci -q set dhcp.lan.start='100'; uci -q set dhcp.lan.limit='100'
         uci -q set dhcp.lan.leasetime='12h'; uci commit dhcp
         /etc/init.d/dnsmasq enable; /etc/init.d/dnsmasq restart
         echo "✓ AP 端已开 DHCP（100~199）";;
    off) uci set dhcp.lan.ignore='1'; uci commit dhcp
         /etc/init.d/dnsmasq stop 2>/dev/null || true
         echo "✓ 回到纯二层透传";;
    *)   echo "用法: bridge-dhcp {on|off}  当前 ignore=$(uci -q get dhcp.lan.ignore)";;
esac
